<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!--
    OWASP Dependency-Check false positive suppression file.

    RULES:
    - until date must be no more than 6 months from review date
    - Suppressions without a reason will be rejected in CODEOWNERS review
    - No CRITICAL CVEs with available fixes may be suppressed

    TEMPLATE (uncomment and fill in when adding a suppression):

    <suppress until="YYYY-MM-DD">
      <notes><![CDATA[
        Reason: [Why this is a false positive — be specific]
        Reviewed by: [Full name]
        Review date: [YYYY-MM-DD]
      ]]></notes>
      <packageUrl regex="true">^pkg:npm/package-name@.*$</packageUrl>
      <cve>CVE-YYYY-NNNNN</cve>
    </suppress>
  -->

</suppressions>
